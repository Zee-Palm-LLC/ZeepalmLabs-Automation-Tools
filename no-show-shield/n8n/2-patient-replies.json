      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst out = (j.texts || []).map(t => ({ json: { from: j.from, to: t.to, text: t.body } }));\nfor (const a of j.alerts || []) out.push({ json: { from: j.from, to: j.frontDesk, text: a } });\nreturn j.send ? out : [];\n"
