    {
      "id": "ddb346c5-b77b-4a27-8f02-cb7fd3fbebd3",
      "name": "Generate 90 Days of Visits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const DAY = 86400000;\nconst now = Date.now();\nlet seed = 777;\nconst rand = () => { seed = (seed * 1103515245 + 12345) % 2147483648; return seed / 2147483648; };\nconst out = [];\nfor (const item of $('Generate Demo Members').all()) {\n  const m = item.json;\n  const days = Math.min(90, m.demo_tenure);\n  for (let d = days; d >= 0; d--) {\n    let p = m.demo_rate;\n    if (m.demo_profile === 'fading' && d <= 30) p = 0.06;\n    if (m.demo_profile === 'ghost' && d <= m.demo_stop_day) p = 0;\n    if (m.demo_profile === 'new') p = (m.demo_tenure - d) <= 10 ? 0.35 : 0.05;\n    if (m.demo_profile === 'recovered' && d <= 32 && d > m.demo_back_day) p = 0;\n    if (m.demo_profile === 'recovered' && d === m.demo_back_day) p = 1;\n    if (rand() < p) {\n      const t = now - d * DAY - Math.floor(rand() * 14 + 6) * 3600000;\n      if (t < now) out.push({ json: { member_ref: m.member_ref, checked_in_at: new Date(t).toISOString(), source: 'demo' } });\n    }\n  }\n}\nreturn out;"
      }
    },
