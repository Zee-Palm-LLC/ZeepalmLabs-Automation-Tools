    {
      "id": "51c97072-2c84-4908-bc2f-22e2fd4a896f",
      "name": "Generate Past Outreach",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const NL = String.fromCharCode(10);\nconst out = [];\nfor (const item of $('Generate Demo Members').all()) {\n  const m = item.json;\n  if (!m.last_outreach_at) continue;\n  const first = m.name.split(' ')[0];\n  out.push({ json: {\n    member_ref: m.member_ref,\n    name: m.name,\n    email: m.email,\n    sent_at: m.last_outreach_at,\n    risk_score: m.demo_profile === 'ghost' ? 85 : 75,\n    risk_level: 'high',\n    risk_reasons: m.demo_profile === 'ghost' ? 'No visit in 21 days; Visits down 100%' : 'No visit in 18 days; Visits down 80%',\n    monthly_fee: m.monthly_fee,\n    subject: 'Your usual spot is waiting',\n    message: ['Hi ' + first + ',', '', 'We have missed seeing you at the gym lately. Restarting is often the hardest part, so we would love to offer you a free 30-minute session with one of our coaches.', '', 'Just reply to this email and we will set it up.', '', 'Sarah'].join(NL),\n    sent_to: 'demo',\n    demo_mode: true\n  } });\n}\nreturn out;"
      }
    },
