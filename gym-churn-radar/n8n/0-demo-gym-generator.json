    {
      "id": "9572e4c4-ac20-4f88-9417-422d9133dfb7",
      "name": "Generate Demo Members",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const DAY = 86400000;\nconst now = Date.now();\nlet seed = 20240917;\nconst rand = () => { seed = (seed * 1103515245 + 12345) % 2147483648; return seed / 2147483648; };\nconst firstNames = ['Ava','Liam','Mia','Noah','Zara','Omar','Emma','Lucas','Sofia','Ethan','Aisha','Leo','Chloe','Ryan','Hana','Adam','Maya','Jack','Nora','Sam','Lily','Yusuf','Grace','Ben','Ella','Kai','Ruby','Dan','Isla','Max','Fatima','Theo','Jade','Owen','Lena','Ali','Rosa','Finn','Amara','Jonah'];\nconst lastNames = ['Khan','Smith','Garcia','Chen','Patel','Brown','Silva','Novak','Ali','Wright','Rossi','Kim','Hughes','Ahmed','Lopez','Evans','Park','Moore','Costa','Reid'];\nconst plans = [['Basic', 39], ['Standard', 59], ['Premium', 89], ['PT Package', 149]];\nconst trainers = ['Coach Mike', 'Coach Sara', 'Coach Dev'];\nconst profiles = ['loyal','loyal','loyal','loyal','loyal','recovered','recovered','fading','ghost','new'];\nconst out = [];\nfor (let i = 0; i < firstNames.length; i++) {\n  const profile = profiles[Math.floor(rand() * profiles.length)];\n  const plan = plans[Math.floor(rand() * plans.length)];\n  const first = firstNames[i];\n  const last = lastNames[Math.floor(rand() * lastNames.length)];\n  const tenure = profile === 'new' ? 20 + Math.floor(rand() * 25) : 120 + Math.floor(rand() * 600);\n  const stopDay = 16 + Math.floor(rand() * 16);\n  const backDay = 3 + Math.floor(rand() * 20);\n  let outreachDaysAgo = null;\n  if (profile === 'recovered') outreachDaysAgo = backDay + 2 + Math.floor(rand() * 4);\n  if (profile === 'ghost' && stopDay >= 22) outreachDaysAgo = 15;\n  out.push({ json: {\n    member_ref: 'DEMO-' + (1001 + i),\n    name: first + ' ' + last,\n    email: (first + '.' + last).toLowerCase() + '@example.com',\n    phone: '',\n    plan: plan[0],\n    monthly_fee: plan[1],\n    join_date: new Date(now - tenure * DAY).toISOString(),\n    status: 'active',\n    trainer: trainers[i % trainers.length],\n    last_outreach_at: outreachDaysAgo === null ? null : new Date(now - outreachDaysAgo * DAY).toISOString(),\n    outreach_count: outreachDaysAgo === null ? 0 : 1,\n    demo_profile: profile,\n    demo_tenure: tenure,\n    demo_stop_day: stopDay,\n    demo_back_day: backDay,\n    demo_rate: 0.3 + rand() * 0.25\n  } });\n}\nreturn out;"
      }
    },
