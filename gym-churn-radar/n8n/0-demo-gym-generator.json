    {
      "id": "3768fc6d-6058-4be0-bb40-b795f9c33182",
      "name": "Sticky Note a7a27621",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -60
      ],
      "parameters": {
        "content": "## 🏋️ Demo Gym Generator\nClick **Execute workflow** to (re)create a realistic demo gym: 40 members, 90 days of visits and past win-back emails.\n\nProfiles: *loyal* regulars, *recovered* members who came back after a win-back email, *fading* members whose visits dropped, *ghosts* who stopped coming, and *new* members who never built a habit.\n\n⚠️ This **clears** the members, visits and outreach tables first. Use it for demos and testing only, never after importing a real gym.",
        "color": 4,
        "width": 720,
        "height": 320
      }
