      "parameters": {
        "formTitle": "Gym Churn Radar settings",
        "formDescription": "Fill in only what you want to change. Empty fields keep their current value.",
        "formFields": {
          "values": [
            {
              "fieldName": "gymName",
              "fieldLabel": "Gym name",
              "fieldType": "text",
              "placeholder": "e.g. IronPulse Fitness"
            },
            {
              "fieldName": "ownerName",
              "fieldLabel": "Owner first name",
              "fieldType": "text"
            },
            {
              "fieldName": "ownerEmail",
              "fieldLabel": "Owner email (reports and alerts go here)",
              "fieldType": "email"
            },
            {
              "fieldName": "senderName",
              "fieldLabel": "Sender name on win-back emails",
              "fieldType": "text",
              "placeholder": "e.g. Sarah from IronPulse Fitness"
            },
            {
              "fieldName": "winbackOffer",
              "fieldLabel": "Win-back offer",
              "fieldType": "textarea",
              "placeholder": "e.g. a free 30-minute session with one of our coaches"
            },
            {
              "fieldName": "bookingLink",
              "fieldLabel": "Booking link (optional)",
              "fieldType": "text",
              "placeholder": "https://..."
            },
            {
              "fieldName": "demoMode",
              "fieldLabel": "Demo mode",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Keep current"
                  },
                  {
                    "option": "On - send all emails to the owner"
                  },
                  {
                    "option": "Off - send win-back emails to members"
                  }
                ]
              }
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Save settings",
          "path": "gym-churn-settings",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Settings saved. They apply to the next scan and report."
            }
          }
        }
      },
      "webhookId": "c1b8ea59-5979-485b-9c59-368759d08cdc"
