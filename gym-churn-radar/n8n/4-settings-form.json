    {
      "id": "41ec9aa3-5e20-48cd-bff1-2277dcbce8d3",
      "name": "Merge Changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const f = $('Change Settings').first().json;\nconst cur = $input.first().json;\nconst val = k => {\n  const v = f[k];\n  return v === undefined || v === null || String(v).trim() === '' ? cur[k] : String(v).trim();\n};\nconst demo = String(f.demoMode || '');\nreturn [{ json: {\n  id: cur.id,\n  gymName: val('gymName'),\n  ownerName: val('ownerName'),\n  ownerEmail: val('ownerEmail'),\n  senderName: val('senderName'),\n  winbackOffer: val('winbackOffer'),\n  bookingLink: val('bookingLink'),\n  demoMode: demo.startsWith('On') ? true : demo.startsWith('Off') ? false : cur.demoMode\n} }];"
      }
    },
    {
      "id": "800be4de-c752-4711-b96f-cf1b8e6a5e67",
