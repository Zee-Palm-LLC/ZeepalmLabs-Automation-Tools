    {
      "id": "cde7502c-bb4f-4a7b-9dba-2c8e186dc150",
      "name": "Build Dashboard Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s = $('Gym Settings').first().json;\nconst DAY = 86400000;\nconst now = Date.now();\nconst members = $('Get Members').all().map(i => i.json).filter(m => m.member_ref);\nconst outreach = $('Get Outreach').all().map(i => i.json).filter(o => o.member_ref && o.sent_at);\nconst visitsByRef = {};\nconst perDay = {};\nfor (let d = 29; d >= 0; d--) perDay[new Date(now - d * DAY).toISOString().slice(0, 10)] = 0;\nlet visitsThisWeek = 0;\nlet visitsLastWeek = 0;\nfor (const item of $input.all()) {\n  const v = item.json;\n  if (!v.member_ref || !v.checked_in_at) continue;\n  const t = new Date(v.checked_in_at).getTime();\n  if (isNaN(t) || t > now) continue;\n  if (!visitsByRef[v.member_ref]) visitsByRef[v.member_ref] = [];\n  visitsByRef[v.member_ref].push(t);\n  const key = new Date(t).toISOString().slice(0, 10);\n  if (key in perDay) perDay[key] += 1;\n  if (now - t <= 7 * DAY) visitsThisWeek += 1;\n  else if (now - t <= 14 * DAY) visitsLastWeek += 1;\n}\nfor (const k of Object.keys(visitsByRef)) visitsByRef[k].sort((a, b) => a - b);\nconst byRef = {};\nfor (const m of members) byRef[m.member_ref] = m;\nconst latest = {};\nfor (const o of outreach) {\n  const t = new Date(o.sent_at).getTime();\n  if (isNaN(t)) continue;\n  if (!latest[o.member_ref] || latest[o.member_ref] < t) latest[o.member_ref] = t;\n}\nconst wins = {};\nlet decided = 0;\nfor (const ref of Object.keys(latest)) {\n  const sent = latest[ref];\n  const back = (visitsByRef[ref] || []).find(t => t > sent && t <= sent + 14 * DAY);\n  if (back) { decided += 1; wins[ref] = { backAt: back, days: Math.max(0, Math.round((back - sent) / DAY)) }; }\n  else if (now - sent >= 14 * DAY) decided += 1;\n}\nlet tried = 0;\nlet returned = 0;\nfor (const o of outreach) {\n  const sent = new Date(o.sent_at).getTime();\n  if (isNaN(sent)) continue;\n  const back = (visitsByRef[o.member_ref] || []).find(t => t > sent && t <= sent + 14 * DAY);\n  if (back) { tried += 1; returned += 1; }\n  else if (now - sent >= 14 * DAY) tried += 1;\n}\nconst fee = ref => Number((byRef[ref] && byRef[ref].monthly_fee) || 0);\nconst wins30 = Object.keys(wins).filter(r => now - wins[r].backAt <= 30 * DAY);\nconst active = members.filter(m => String(m.status || 'active').toLowerCase() === 'active');\nconst scored = active.filter(m => m.risk_level);\nconst high = scored.filter(m => m.risk_level === 'high');\nconst medium = scored.filter(m => m.risk_level === 'medium');\nconst low = scored.filter(m => m.risk_level === 'low');\nconst iso = v => { if (!v) return null; const d = new Date(v); return isNaN(d.getTime()) ? null : d.toISOString(); };\nconst memberRows = members.map(m => ({\n  ref: m.member_ref,\n  status: String(m.status || 'active').toLowerCase(),\n  phone: m.phone || '',\n  name: m.name || m.member_ref,\n  email: m.email || '',\n  plan: m.plan || '',\n  fee: Number(m.monthly_fee || 0),\n  trainer: m.trainer || '',\n  joinDate: iso(m.join_date),\n  lastVisit: iso(m.last_visit),\n  daysSinceVisit: m.last_visit ? Math.floor((now - new Date(m.last_visit).getTime()) / DAY) : null,\n  visits30: m.visits_30d == null ? null : Number(m.visits_30d),\n  visitsPrev60: m.visits_prev_60d == null ? null : Number(m.visits_prev_60d),\n  score: m.risk_score == null ? null : Number(m.risk_score),\n  level: m.risk_level || 'unscored',\n  reasons: m.risk_reasons ? String(m.risk_reasons).split('; ').filter(Boolean) : [],\n  lastOutreachAt: iso(m.last_outreach_at),\n  outreachCount: Number(m.outreach_count || 0),\n  cameBack: !!wins[m.member_ref],\n  recentVisits: (visitsByRef[m.member_ref] || []).filter(t => now - t <= 56 * DAY).map(t => new Date(t).toISOString().slice(0, 10))\n})).sort((a, b) => (b.score ?? -1) - (a.score ?? -1) || b.fee - a.fee);\nconst outreachRows = outreach\n  .map(o => ({\n    ref: o.member_ref,\n    name: o.name || (byRef[o.member_ref] && byRef[o.member_ref].name) || o.member_ref,\n    sentAt: iso(o.sent_at),\n    subject: o.subject || '',\n    message: o.message || '',\n    riskScore: o.risk_score == null ? null : Number(o.risk_score),\n    reasons: o.risk_reasons || '',\n    fee: fee(o.member_ref),\n    cameBack: !!(wins[o.member_ref] && latest[o.member_ref] === new Date(o.sent_at).getTime()),\n    daysToReturn: wins[o.member_ref] ? wins[o.member_ref].days : null,\n    demo: !!o.demo_mode\n  }))\n  .sort((a, b) => String(b.sentAt).localeCompare(String(a.sentAt)))\n  .slice(0, 40);\nconst lastScanAt = scored.reduce((a, m) => { const t = iso(m.scored_at); return t && (!a || t > a) ? t : a; }, null);\nconst stats = {\n  activeMembers: active.length,\n  scoredMembers: scored.length,\n  highRisk: high.length,\n  mediumRisk: medium.length,\n  lowRisk: low.length,\n  monthlyRevenueAtRisk: high.concat(medium).reduce((a, m) => a + Number(m.monthly_fee || 0), 0),\n  membersBackLast30Days: wins30.length,\n  monthlyRevenueWonBackLast30Days: wins30.reduce((a, r) => a + fee(r), 0),\n  winbackRatePercent: tried ? Math.round((returned / tried) * 100) : null,\n  emailsLast7Days: outreach.filter(o => now - new Date(o.sent_at).getTime() <= 7 * DAY).length,\n  emailsTotal90Days: outreach.length,\n  visitsThisWeek,\n  visitsLastWeek\n};\nreturn [{ json: {\n  gym: { name: s.gymName, ownerName: s.ownerName, currency: s.currency || '$', demoMode: !!s.demoMode },\n  settings: { gymName: s.gymName, ownerName: s.ownerName, ownerEmail: s.ownerEmail, senderName: s.senderName, winbackOffer: s.winbackOffer, bookingLink: s.bookingLink || '', currency: s.currency || '$', highRiskScore: s.highRiskScore, mediumRiskScore: s.mediumRiskScore, outreachCooldownDays: s.outreachCooldownDays, maxOutreachPerDay: s.maxOutreachPerDay, maxOutreachPerMember: s.maxOutreachPerMember, demoMode: !!s.demoMode },\n  stats,\n  members: memberRows,\n  outreach: outreachRows,\n  trend: Object.keys(perDay).map(date => ({ date, count: perDay[date] })),\n  lastScanAt,\n  generatedAt: new Date(now).toISOString()\n} }];"
      }
    },
