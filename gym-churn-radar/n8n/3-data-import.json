                    "option": "Members list"
                  },
                  {
                    "option": "Check-in history"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldName": "csv_file",
              "fieldLabel": "CSV file",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".csv",
              "requiredField": true
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Upload",
          "path": "gym-churn-upload",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Thanks! Your file is being imported. Risk scores update on the next daily scan."
            }
          }
        }
      },
      "webhookId": "5f4b41e5-7b53-4a2c-9240-07c1642e4b55"
    },
