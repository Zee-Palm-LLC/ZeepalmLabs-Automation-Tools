      "name": "Read CSV",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        240,
        520
      ],
      "parameters": {
        "operation": "csv",
        "binaryPropertyName": "={{ Object.keys($binary || {})[0] || \"csv_file\" }}",
        "options": {
