    {
      "id": "2e0add53-6e15-40b9-8783-eb58db1d466c",
      "name": "Clean and Map Columns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const type = String($('Upload Gym Data').first().json.upload_type || '').toLowerCase();\nconst isMembers = type.startsWith('member');\nconst norm = k => String(k).trim().toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');\nconst pick = (row, keys) => {\n  for (const k of keys) {\n    if (row[k] !== undefined && row[k] !== null && String(row[k]).trim() !== '') return String(row[k]).trim();\n  }\n  return '';\n};\nconst toIso = v => {\n  if (!v) return null;\n  const d = new Date(v);\n  return isNaN(d.getTime()) ? null : d.toISOString();\n};\nconst out = [];\nfor (const item of $input.all()) {\n  const row = {};\n  for (const [k, v] of Object.entries(item.json)) row[norm(k)] = v;\n  if (isMembers) {\n    const email = pick(row, ['email', 'email_address', 'e_mail']).toLowerCase();\n    const ref = pick(row, ['member_ref', 'member_id', 'memberid', 'membership_number', 'member_number', 'barcode', 'id']) || email;\n    if (!ref) continue;\n    const first = pick(row, ['first_name', 'firstname']);\n    const last = pick(row, ['last_name', 'lastname', 'surname']);\n    const name = pick(row, ['name', 'full_name', 'member_name']) || (first + ' ' + last).trim();\n    const statusRaw = pick(row, ['status', 'membership_status']).toLowerCase();\n    const status = !statusRaw ? 'active' : /cancel|expired|inactive|terminated|ended/.test(statusRaw) ? 'cancelled' : /freeze|frozen|hold|paused|suspend/.test(statusRaw) ? 'frozen' : 'active';\n    const fee = parseFloat(pick(row, ['monthly_fee', 'fee', 'price', 'monthly_price', 'dues', 'amount', 'rate']).replace(/[^0-9.]/g, ''));\n    out.push({ json: {\n      kind: 'member',\n      member_ref: ref.includes('@') ? ref.toLowerCase() : ref,\n      name,\n      email,\n      phone: pick(row, ['phone', 'mobile', 'phone_number', 'cell']),\n      plan: pick(row, ['plan', 'membership', 'membership_type', 'package', 'tier']),\n      monthly_fee: isNaN(fee) ? 0 : fee,\n      join_date: toIso(pick(row, ['join_date', 'joined', 'start_date', 'member_since', 'signup_date', 'created'])),\n      status,\n      trainer: pick(row, ['trainer', 'coach', 'personal_trainer'])\n    } });\n  } else {\n    const ref = pick(row, ['member_ref', 'member_id', 'memberid', 'membership_number', 'member_number', 'barcode', 'id', 'email', 'email_address']);\n    const date = pick(row, ['checked_in_at', 'check_in', 'checkin', 'check_in_time', 'timestamp', 'date_time', 'datetime', 'visit_date', 'visited_at', 'date']);\n    const time = pick(row, ['time', 'check_in_hour']);\n    const iso = toIso(time && date.length <= 10 ? date + ' ' + time : date);\n    if (!ref || !iso) continue;\n    out.push({ json: { kind: 'checkin', member_ref: ref.includes('@') ? ref.toLowerCase() : ref, checked_in_at: iso, source: 'csv import' } });\n  }\n}\nreturn out;"
      }
    },
