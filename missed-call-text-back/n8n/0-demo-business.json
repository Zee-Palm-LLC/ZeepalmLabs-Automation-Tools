    {
      "id": "14acb923-67c6-4e19-8bbd-eb443ccb176d",
      "name": "Move Dates to Today",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        192
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst zone = d.timezone || 'America/Chicago';\nconst nowMs = Date.now();\nconst days = Math.floor((nowMs - new Date(d.anchor).getTime()) / 86400000);\nconst shift = v => (v ? DateTime.fromISO(v).setZone(zone).plus({ days }).toUTC().toISO() : null);\nconst ms = v => (v ? new Date(v).getTime() : 0);\n\nconst leads = (d.leads || []).map(l => {\n  const o = Object.assign({}, l);\n  ['slot', 'first_reply_at', 'alerted_at', 'booked_at', 'created_at', 'last_at'].forEach(k => {\n    o[k] = shift(o[k]);\n  });\n  let offered = [];\n  try {\n    offered = JSON.parse(o.offered || '[]');\n  } catch (e) {\n    offered = [];\n  }\n  o.offered = JSON.stringify(offered.map(shift));\n  return o;\n}).filter(l => ms(l.created_at) <= nowMs);\nconst keep = {};\nleads.forEach(l => {\n  keep[l.lead_id] = true;\n  if (ms(l.last_at) > nowMs) l.last_at = new Date(nowMs).toISOString();\n});\nconst calls = (d.calls || []).map(c => Object.assign({}, c, { at: shift(c.at) })).filter(c => ms(c.at) <= nowMs && (!c.lead_id || keep[c.lead_id]));\nconst messages = (d.messages || []).map(m => Object.assign({}, m, { at: shift(m.at) })).filter(m => ms(m.at) <= nowMs && keep[m.lead_id]);\n\nreturn [{ json: { leads, calls, messages } }];\n"
      }
    },
