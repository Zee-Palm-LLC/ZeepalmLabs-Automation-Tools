      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "SELECT_MCTB_LEADS_TABLE",
          "cachedResultName": "mctb_leads"
        },
        "matchType": "anyCondition",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "texted"
            },
            {
              "keyName": "status",
