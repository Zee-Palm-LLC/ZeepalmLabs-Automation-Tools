    {
      "id": "03705d16-3054-4f6c-b9ab-9e5408c35561",
      "name": "Pick Nudges",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ],
      "parameters": {
        "jsCode": "const s = $('Load Settings').first().json;\nconst nowMs = Date.now();\nconst nowIso = new Date(nowMs).toISOString();\nconst stamp = nowMs.toString(36);\nconst makeId = p => p + stamp + Math.floor(Math.random() * 46656).toString(36);\nconst ms = v => (v ? new Date(v).getTime() : 0);\nconst firstWait = (Number(s.followUpMinutes) || 30) * 60000;\nconst lastWait = (Number(s.finalFollowUpHours) || 20) * 3600000;\nconst out = [];\n\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!r || !r.lead_id) continue;\n  const lead = Object.assign({}, r);\n  delete lead.id;\n  delete lead.createdAt;\n  delete lead.updatedAt;\n  const age = nowMs - ms(lead.created_at);\n  const sent = Number(lead.follow_ups) || 0;\n  let text = null;\n  if (lead.status === 'texted' && sent === 0 && age >= firstWait) {\n    lead.follow_ups = 1;\n    text = 'Just checking in, do you still need a hand? Reply here and we can usually get someone out within a day.';\n  } else if (lead.status === 'texted' && sent === 1 && age >= lastWait) {\n    lead.follow_ups = 2;\n    lead.status = 'no_reply';\n    text = \"Last text from us, promise. If you still need a plumber, just reply and we'll fit you in.\";\n  } else if (lead.status === 'chatting' && nowMs - ms(lead.last_at) > 26 * 3600000) {\n    lead.status = 'no_reply';\n  } else {\n    continue;\n  }\n  const message = text ? { msg_id: makeId('m'), lead_id: lead.lead_id, phone: lead.phone, dir: 'out', author: 'ai', body: text, at: nowIso } : null;\n  if (text) lead.last_at = nowIso;\n  out.push({ json: { lead, message, send: !!text && !s.demoMode, to: lead.phone, from: s.businessPhone, text } });\n}\n\nreturn out;\n"
      }
    },
