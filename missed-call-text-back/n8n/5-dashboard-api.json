    {
      "id": "7c961d94-4106-4a9c-9c5b-544fa73a5460",
      "name": "Lead Change",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        1136
      ],
      "parameters": {
        "jsCode": "const a = $('Read Action').first().json;\nif (!a.lead) throw new Error('Missing lead');\nconst patch = { lead_id: a.lead };\nif (a.action === 'pause') {\n  patch.ai_paused = String(a.paused) === 'true';\n  if (!patch.ai_paused) patch.needs_call = false;\n}\nif (a.action === 'ack') {\n  patch.ack = true;\n  patch.needs_call = false;\n}\nif (a.action === 'status') {\n  if (!['texted', 'chatting', 'urgent', 'booked', 'no_reply', 'lost', 'opted_out'].includes(a.status)) throw new Error('Unknown status');\n  patch.status = a.status;\n  if (a.status !== 'booked') patch.slot = null;\n}\nreturn [{ json: patch }];\n"
      }
    },
