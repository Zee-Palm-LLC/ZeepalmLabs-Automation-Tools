        608
      ],
      "parameters": {
        "jsCode": "const lead = $input.first().json;\nif (!lead || !lead.lead_id) throw new Error('That conversation no longer exists');\nreturn [{ json: {\n  lead_id: lead.lead_id,\n  ai_paused: true,\n  status: lead.status === 'texted' ? 'chatting' : lead.status,\n  last_at: new Date().toISOString()\n} }];\n"
      }
    },
    {
