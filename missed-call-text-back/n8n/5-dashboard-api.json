        1120,
        1328
      ],
      "parameters": {
        "jsCode": "const q = $('Read Action').first().json.params;\nconst cur = $('Settings for Action').first().json || {};\nconst NUMBERS = ['vans', 'ringSeconds', 'followUpMinutes', 'finalFollowUpHours'];\nconst FLAGS = ['aiEnabled', 'demoMode'];\nconst TEXT = ['businessName', 'shortName', 'ownerName', 'ownerPhone', 'ownerEmail', 'businessPhone', 'currency', 'timezone', 'areaLabel', 'serviceZips', 'weekdayHours', 'saturdayHours', 'slotTimes', 'textBack', 'afterHours', 'claudeModel', 'services'];\nconst row = { settings_key: 'main' };\nNUMBERS.concat(FLAGS, TEXT).forEach(k => {\n  if (cur[k] !== undefined) row[k] = cur[k];\n  if (q[k] === undefined) return;\n  if (NUMBERS.includes(k)) row[k] = Number(q[k]) || 0;\n  else if (FLAGS.includes(k)) row[k] = String(q[k]) === 'true';\n  else row[k] = String(q[k]).slice(0, 4000);\n});\nif (row.services) JSON.parse(row.services);\nreturn [{ json: row }];\n"
      }
    },
