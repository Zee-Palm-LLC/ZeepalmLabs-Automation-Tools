    {
      "id": "6ec99f00-2788-42b5-85e7-12d5bb800624",
      "name": "Build Dashboard Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $('Load Settings').first().json;\nconst tz = raw.timezone || 'America/Chicago';\nconst nowMs = Date.now();\nconst ms = v => (v ? new Date(v).getTime() : 0);\nconst iso = v => (v ? new Date(v).toISOString() : null);\nconst num = v => (v === null || v === undefined || v === '' ? null : Number(v));\n\nconst settings = Object.assign({}, raw);\ndelete settings.id;\ndelete settings.createdAt;\ndelete settings.updatedAt;\ndelete settings.settings_key;\ntry {\n  settings.services = typeof raw.services === 'string' ? JSON.parse(raw.services) : raw.services || [];\n} catch (e) {\n  settings.services = [];\n}\n['vans', 'ringSeconds', 'followUpMinutes', 'finalFollowUpHours'].forEach(k => {\n  settings[k] = Number(settings[k]) || 0;\n});\nsettings.aiEnabled = !!settings.aiEnabled;\nsettings.demoMode = !!settings.demoMode;\n\nconst leads = $('Recent Leads').all().map(i => i.json).filter(r => r && r.lead_id).map(r => {\n  let offered = [];\n  try {\n    offered = JSON.parse(r.offered || '[]');\n  } catch (e) {\n    offered = [];\n  }\n  return {\n    id: r.lead_id, phone: r.phone, name: r.name || null, status: r.status, source: r.source, service: r.service || null,\n    issue: r.issue || null, urgency: r.urgency || null, urgent: !!r.urgent, zip: r.zip || null, address: r.address || null,\n    offered, slot: iso(r.slot), value: Number(r.value) || 0, needsCall: !!r.needs_call, ack: r.ack !== false,\n    aiPaused: !!r.ai_paused, followUps: Number(r.follow_ups) || 0, textBackSeconds: num(r.text_back_seconds),\n    firstReplyAt: iso(r.first_reply_at), alertedAt: iso(r.alerted_at), bookedAt: iso(r.booked_at), bookedBy: r.booked_by || null,\n    reason: r.reason || null, summary: r.summary || null, createdAt: iso(r.created_at), lastAt: iso(r.last_at), callCount: Number(r.call_count) || 0\n  };\n});\nconst calls = $('Recent Calls').all().map(i => i.json).filter(r => r && r.call_id).map(r => ({\n  id: r.call_id, leadId: r.lead_id || null, phone: r.phone, at: iso(r.at), outcome: r.outcome, ringSeconds: Number(r.ring_seconds) || 0,\n  duration: Number(r.duration) || 0, textBackSeconds: num(r.text_back_seconds), note: r.note || null\n}));\nconst messages = $('Recent Messages').all().map(i => i.json).filter(r => r && r.msg_id).map(r => ({\n  id: r.msg_id, leadId: r.lead_id, phone: r.phone, dir: r.dir, author: r.author, body: r.body, at: iso(r.at)\n}));\nleads.sort((a, b) => ms(b.lastAt) - ms(a.lastAt));\ncalls.sort((a, b) => ms(b.at) - ms(a.at));\nmessages.sort((a, b) => ms(a.at) - ms(b.at));\n\nconst since = nowMs - 30 * 86400000;\nconst inWindow = calls.filter(c => ms(c.at) >= since);\nconst missed = inWindow.filter(c => c.outcome !== 'answered');\nconst fromCalls = leads.filter(l => ms(l.createdAt) >= since && l.source === 'call');\nconst texted = fromCalls.filter(l => l.textBackSeconds !== null);\nconst replied = fromCalls.filter(l => l.firstReplyAt);\nconst booked = fromCalls.filter(l => l.status === 'booked');\nconst byStatus = {};\nfromCalls.forEach(l => {\n  byStatus[l.status] = (byStatus[l.status] || 0) + 1;\n});\nconst heat = [0, 1, 2, 3, 4, 5, 6].map(() => new Array(24).fill(0));\nmissed.forEach(c => {\n  const d = DateTime.fromMillis(ms(c.at)).setZone(tz);\n  heat[d.weekday % 7][d.hour] += 1;\n});\nconst avg = texted.length ? texted.reduce((a, l) => a + l.textBackSeconds, 0) / texted.length : 0;\n\nconst stats = {\n  calls: inWindow.length,\n  answered: inWindow.length - missed.length,\n  missed: missed.length,\n  afterHours: missed.filter(c => c.outcome === 'after_hours').length,\n  texted: texted.length,\n  replied: replied.length,\n  booked: booked.length,\n  bookedByAi: booked.filter(l => l.bookedBy === 'ai').length,\n  urgent: fromCalls.filter(l => l.urgent).length,\n  recovered: booked.reduce((a, l) => a + l.value, 0),\n  avgTextBack: Math.round(avg * 10) / 10,\n  replyRate: texted.length ? replied.length / texted.length : 0,\n  bookRate: missed.length ? booked.length / missed.length : 0,\n  byStatus,\n  heat,\n  needsYou: leads.filter(l => (l.urgent || l.needsCall) && !l.ack && !['lost', 'opted_out'].includes(l.status)).length,\n  open: leads.filter(l => ['texted', 'chatting', 'urgent'].includes(l.status)).length\n};\n\nreturn [{ json: { settings, leads, calls, messages, stats, now: new Date(nowMs).toISOString() } }];\n"
      }
    },
