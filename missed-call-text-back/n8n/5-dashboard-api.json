      ],
      "parameters": {
        "jsCode": "const phone = $('Read Action').first().json.phone;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.lead_id && r.phone === phone);\nrows.sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime());\nreturn [{ json: { ok: true, leadId: rows[0] ? rows[0].lead_id : null } }];\n"
      }
    },
