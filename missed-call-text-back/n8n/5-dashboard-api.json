      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        896
      ],
      "parameters": {
        "jsCode": "const a = $('Read Action').first().json;\nconst lead = $input.first().json;\nif (!lead || !lead.lead_id) throw new Error('That conversation no longer exists');\nif (lead.status === 'opted_out') throw new Error('This person opted out of texts');\nconst body = String(a.text || '').trim().slice(0, 480);\nif (!body) throw new Error('The message is empty');\nreturn [{ json: {\n  msg_id: 'm' + Date.now().toString(36) + Math.floor(Math.random() * 46656).toString(36),\n  lead_id: lead.lead_id,\n  phone: lead.phone,\n  dir: 'out',\n  author: 'owner',\n  body,\n  at: new Date().toISOString()\n} }];\n"
      }
    },
