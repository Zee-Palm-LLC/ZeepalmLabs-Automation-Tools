    {
      "id": "d83e57b7-41e3-4409-b523-53e1773465c6",
      "name": "Plan Text Back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        512
      ],
      "parameters": {
        "jsCode": "const call = $('Call Details').first().json;\nconst s = $('Load Settings').first().json;\nconst tz = s.timezone || 'America/Chicago';\nconst now = DateTime.now().setZone(tz);\nconst nowIso = now.toUTC().toISO();\nconst phone = String(call.phone || '').trim();\nconst stamp = now.toMillis().toString(36);\nconst makeId = p => p + stamp + Math.floor(Math.random() * 46656).toString(36);\nconst clean = r => {\n  const o = Object.assign({}, r);\n  delete o.id;\n  delete o.createdAt;\n  delete o.updatedAt;\n  return o;\n};\nconst toMin = v => {\n  const p = String(v).trim().split(':');\n  return Number(p[0]) * 60 + Number(p[1] || 0);\n};\nconst isOpen = t => {\n  if (t.weekday === 7) return false;\n  const range = String(t.weekday === 6 ? s.saturdayHours : s.weekdayHours).split('-');\n  if (range.length < 2) return false;\n  const m = t.hour * 60 + t.minute;\n  return m >= toMin(range[0]) && m < toMin(range[1]);\n};\n\nconst answered = ['completed', 'answered'].includes(String(call.status || '').toLowerCase());\nconst callRow = {\n  call_id: makeId('c'),\n  lead_id: null,\n  phone,\n  at: nowIso,\n  outcome: answered ? 'answered' : isOpen(now) ? 'missed' : 'after_hours',\n  ring_seconds: answered ? 0 : Number(s.ringSeconds) || 20,\n  duration: Number(call.duration) || 0,\n  text_back_seconds: null,\n  note: null\n};\nif (answered || !phone) return [{ json: { answered: true, send: false, call: callRow, lead: null, message: null } }];\n\nconst rows = $input.all().map(i => i.json).filter(r => r && r.lead_id && r.phone === phone);\nrows.sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime());\nconst prev = rows[0] ? clean(rows[0]) : null;\n\nif (prev && prev.status === 'opted_out') {\n  callRow.lead_id = prev.lead_id;\n  callRow.note = 'Opted out, no text sent';\n  return [{ json: { answered: false, send: false, call: callRow, lead: null, message: null } }];\n}\n\nconst recent = prev && prev.status !== 'lost' && now.toMillis() - new Date(prev.last_at).getTime() < 3 * 86400000;\nconst lead = recent ? prev : {\n  lead_id: makeId('l'),\n  phone,\n  name: null,\n  status: 'texted',\n  source: 'call',\n  service: null,\n  issue: null,\n  urgency: null,\n  urgent: false,\n  zip: null,\n  address: null,\n  offered: '[]',\n  slot: null,\n  value: 0,\n  needs_call: false,\n  ack: true,\n  ai_paused: false,\n  follow_ups: 0,\n  text_back_seconds: null,\n  first_reply_at: null,\n  alerted_at: null,\n  booked_at: null,\n  booked_by: null,\n  reason: null,\n  summary: null,\n  created_at: nowIso,\n  last_at: nowIso,\n  call_count: 0\n};\nlead.call_count = (Number(lead.call_count) || 0) + 1;\ncallRow.lead_id = lead.lead_id;\n\nconst talking = recent && prev.first_reply_at && now.toMillis() - new Date(prev.last_at).getTime() < 2 * 3600000;\nif (talking) {\n  callRow.note = 'Already texting';\n  return [{ json: { answered: false, send: false, call: callRow, lead, message: null } }];\n}\n\nconst received = call.received_at ? new Date(call.received_at).getTime() : now.toMillis();\nconst secs = Math.max(1, Math.round((now.toMillis() - received) / 1000) + 1);\nconst template = isOpen(now) ? s.textBack : s.afterHours;\nconst text = String(template || '').split('{business}').join(s.shortName || s.businessName).split('{owner}').join(s.ownerName);\ncallRow.text_back_seconds = secs;\nif (lead.text_back_seconds === null || lead.text_back_seconds === undefined) lead.text_back_seconds = secs;\nif (lead.status === 'no_reply') lead.status = 'texted';\nlead.last_at = nowIso;\nconst message = { msg_id: makeId('m'), lead_id: lead.lead_id, phone, dir: 'out', author: 'ai', body: text, at: nowIso };\n\nreturn [{ json: { answered: false, send: !s.demoMode, call: callRow, lead, message, to: phone, from: s.businessPhone, text } }];\n"
      }
    },
