      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst b = j.body && typeof j.body === 'object' ? j.body : null;\nreturn [{ json: {\n  phone: String(b ? b.From || '' : j.phone || '').trim(),\n  status: b ? String(b.DialCallStatus || 'no-answer') : 'no-answer',\n  duration: b ? Number(b.DialCallDuration || 0) : 0,\n  via: b ? 'twilio' : 'dashboard',\n  received_at: new Date().toISOString()\n} }];\n"
      }
    },
