      "name": "Texts to Send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst out = (j.texts || []).map(t => ({ json: { from: j.from, to: t.to, text: t.body } }));\nreturn j.send ? out : [];\n"
      }
    },
    {
      "id": "bb4cb3a9-c1b5-4803-b775-c5687d137222",
      "name": "Send the Texts",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        672,
        0
      ],
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "from": "={{ $json.from }}",
        "to": "={{ $json.to }}",
        "message": "={{ $json.text }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    },
    {
      "id": "6a0b591e-43c6-471b-8fec-e82e8fdbdc38",
      "name": "Sticky Note d6401235",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        272,
        0
      ],
      "parameters": {
        "content": "## Dose check-ins\nEvery 5 minutes the engine texts each reminder as it comes due, listing every pill by what it looks like.\n\nNo reply after 20 minutes gets one gentle nudge. After 45 minutes the first contact in the family is texted, after 90 minutes the backups, and after 3 hours the dose is logged as missed. Family texts wait for the end of quiet hours. In demo mode nothing is sent.",
        "color": 7
      }
    }
  ],
